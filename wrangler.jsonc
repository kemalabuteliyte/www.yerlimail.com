{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "wwwyerlimailcom",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
